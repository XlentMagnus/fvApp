PORT=3000
# Krävs i produktion: minst 32 slumpmässiga tecken.
# Generera: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string-in-production
NODE_ENV=development
DB_PATH=./db/fv_app.db

# Antal reverse proxies framför appen (t.ex. 1 bakom nginx/Caddy). Behövs för HTTPS-cookies och rätt IP.
# TRUST_PROXY=1

# Vem medlemmar ska kontakta om de vill avanmäla sig med kort varsel
CONTACT_NAME=Föreningens bemanningsansvarig
# Hur många timmar före passet man senast kan avanmäla sig själv
UNSIGN_MIN_HOURS=24

# Publik adress till appen – används i länkar i mejl och kalenderprenumerationer
APP_URL=http://localhost:3000
APP_NAME=FV Alpin – Bemanning

# Mejlpåminnelser (SMTP). Utan SMTP_HOST skrivs mejlen bara ut i konsolen.
# Exempel Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, app-lösenord i SMTP_PASS
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=bemanning@example.com
# SMTP_PASS=
# SMTP_FROM="FV Alpin <bemanning@example.com>"
# Hur många timmar före passet påminnelsen skickas
REMINDER_HOURS_BEFORE=24
