{
  "name": "fv-app",
  "version": "1.0.0",
  "description": "Föreningsverktyg – planeringsverktyg för arbetsuppgifter i föreningar",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node db/migrate.js",
    "seed": "node db/seed/index.js",
    "setup": "npm run migrate && npm run seed",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css --minify",
    "migrate:merge-lift": "node db/scripts/merge-lift-tasks.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcrypt": "^6.0.0",
    "cookie-session": "^2.1.1",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "morgan": "^1.10.0",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "tailwindcss": "^3.4.17"
  },
  "engines": {
    "node": ">=20"
  }
}
